{
  "name": "@genai-news/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env --import tsx --import ./src/instrumentation.ts src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=.env --import ./dist/instrumentation.js dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@genai-news/observability": "workspace:*",
    "@genai-news/queue": "workspace:*",
    "@genai-news/schemas": "workspace:*",
    "bullmq": "^6.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "tsx": "^4.23.12",
    "vitest": "^4.1.10"
  }
}
