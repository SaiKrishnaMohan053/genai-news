generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model SystemRecord {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("system_records")
}

model Article {
  id           String @id @default(cuid())

  title        String
  url          String
  canonicalUrl String @unique

  sourceId     String
  sourceName   String
  sourceType   String

  publisherId   String?
  publisherName String?

  externalId String?

  publishedAt      DateTime?
  firstDiscoveredAt DateTime
  lastSeenAt        DateTime

  author   String?
  summary  String?
  category String?

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sourceId, externalId])
  @@index([publishedAt])
  @@index([lastSeenAt])
  @@map("articles")
}