{
  "name": "genai-news",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "pnpm": "11.22.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "test:integration": "pnpm --filter @genai-news/api test:integration && pnpm --filter @genai-news/worker test:integration",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:up": "docker compose --env-file infra/docker/.env -f infra/docker/compose.yml up -d",
    "infra:down": "docker compose --env-file infra/docker/.env -f infra/docker/compose.yml down",
    "infra:status": "docker compose --env-file infra/docker/.env -f infra/docker/compose.yml ps",
    "infra:logs": "docker compose --env-file infra/docker/.env -f infra/docker/compose.yml logs -f"
  },
  "devDependencies": {
    "prettier": "3.9.0",
    "typescript": "5.9.3"
  }
}
